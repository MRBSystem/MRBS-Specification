{
  "$schema": "https://mrbs.dev/schema/v1/template.manifest.json",
  "template": {
    "type": "document",
    "name": "Corporate Document Templates",
    "version": "1.0.0",
    "description": "Standard templates for business documents"
  },
  "page_setup": {
    "size": "letter",
    "dimensions": {
      "width": "8.5in",
      "height": "11in"
    },
    "margins": {
      "top": "1in",
      "bottom": "1in",
      "left": "1in",
      "right": "1in"
    },
    "alternative_sizes": {
      "a4": {
        "width": "210mm",
        "height": "297mm"
      }
    }
  },
  "typography": {
    "body": {
      "font": "{typography.font_family.body}",
      "size": "11pt",
      "line_height": 1.5,
      "color": "{color.neutral.900}"
    },
    "h1": {
      "font": "{typography.font_family.heading}",
      "size": "24pt",
      "weight": 700,
      "color": "{color.neutral.900}",
      "spacing_before": "24pt",
      "spacing_after": "12pt"
    },
    "h2": {
      "font": "{typography.font_family.heading}",
      "size": "18pt",
      "weight": 600,
      "color": "{color.neutral.900}",
      "spacing_before": "18pt",
      "spacing_after": "6pt"
    },
    "h3": {
      "font": "{typography.font_family.heading}",
      "size": "14pt",
      "weight": 600,
      "color": "{color.neutral.800}",
      "spacing_before": "12pt",
      "spacing_after": "6pt"
    },
    "h4": {
      "font": "{typography.font_family.heading}",
      "size": "12pt",
      "weight": 500,
      "color": "{color.neutral.800}",
      "spacing_before": "12pt",
      "spacing_after": "6pt"
    }
  },
  "templates": [
    {
      "id": "report",
      "name": "Business Report",
      "file": "report-template.docx",
      "purpose": "Formal reports, analyses, and documentation",
      "sections": {
        "cover_page": {
          "required": true,
          "elements": ["title", "subtitle", "date", "author", "logo"]
        },
        "executive_summary": {
          "required": "recommended",
          "max_words": 300,
          "position": "after_cover"
        },
        "table_of_contents": {
          "required": "for_docs_over_5_pages",
          "auto_generate": true
        },
        "body": {
          "required": true,
          "heading_hierarchy": "h1 > h2 > h3 > h4"
        },
        "appendix": {
          "required": false,
          "heading_style": "Appendix A: [Title]"
        }
      },
      "header": {
        "content": "Document title or section name",
        "position": "right",
        "exclude_first_page": true
      },
      "footer": {
        "content": "Page {page} of {total}",
        "position": "center",
        "include_logo": false
      }
    },
    {
      "id": "proposal",
      "name": "Business Proposal",
      "file": "proposal-template.docx",
      "purpose": "Client proposals and project bids",
      "sections": {
        "cover_page": {
          "required": true,
          "elements": ["title", "client_name", "date", "prepared_by", "logo"]
        },
        "executive_summary": {
          "required": true,
          "max_words": 250
        },
        "scope": {
          "required": true,
          "heading": "Scope of Work"
        },
        "approach": {
          "required": true,
          "heading": "Our Approach"
        },
        "timeline": {
          "required": true,
          "heading": "Timeline & Milestones"
        },
        "investment": {
          "required": true,
          "heading": "Investment",
          "note": "Use 'Investment' not 'Cost' or 'Pricing'"
        },
        "about_us": {
          "required": "recommended",
          "heading": "About [Company]"
        },
        "next_steps": {
          "required": true,
          "heading": "Next Steps"
        }
      }
    },
    {
      "id": "memo",
      "name": "Internal Memo",
      "file": "memo-template.docx",
      "purpose": "Internal communications",
      "sections": {
        "header_block": {
          "required": true,
          "fields": ["to", "from", "date", "subject"]
        },
        "body": {
          "required": true,
          "max_pages": 2,
          "style": "concise"
        }
      },
      "formatting": {
        "no_cover_page": true,
        "single_spaced": true
      }
    },
    {
      "id": "letter",
      "name": "Business Letter",
      "file": "letter-template.docx",
      "purpose": "Formal external correspondence",
      "sections": {
        "letterhead": {
          "required": true,
          "elements": ["logo", "company_address", "contact_info"]
        },
        "date": {
          "required": true,
          "format": "MMMM D, YYYY",
          "position": "below_letterhead"
        },
        "recipient": {
          "required": true,
          "format": "Name\\nTitle\\nCompany\\nAddress"
        },
        "salutation": {
          "required": true,
          "format": "Dear [Title] [Last Name]:"
        },
        "body": {
          "required": true,
          "paragraphs": "3-5 recommended"
        },
        "closing": {
          "required": true,
          "options": ["Sincerely,", "Best regards,", "Respectfully,"]
        },
        "signature": {
          "required": true,
          "elements": ["signature_line", "printed_name", "title"]
        }
      }
    },
    {
      "id": "one_pager",
      "name": "One-Pager",
      "file": "one-pager-template.docx",
      "purpose": "Executive summaries, product overviews",
      "constraints": {
        "max_pages": 1,
        "layout": "designed",
        "visual_heavy": true
      },
      "sections": {
        "headline": {
          "required": true,
          "max_words": 8
        },
        "key_points": {
          "required": true,
          "max_items": 3,
          "style": "bullet_with_icons"
        },
        "supporting_visual": {
          "required": "recommended",
          "types": ["chart", "diagram", "image"]
        },
        "call_to_action": {
          "required": true,
          "position": "bottom"
        }
      }
    }
  ],
  "styles": {
    "paragraphs": {
      "normal": {
        "font": "{typography.font_family.body}",
        "size": "11pt",
        "spacing_after": "6pt",
        "line_height": 1.5
      },
      "no_spacing": {
        "spacing_after": "0pt"
      }
    },
    "lists": {
      "bullet": {
        "symbol": "•",
        "indent": "0.25in",
        "spacing": "3pt between items"
      },
      "numbered": {
        "format": "1.",
        "indent": "0.25in"
      }
    },
    "tables": {
      "header_row": {
        "background": "{color.neutral.100}",
        "font_weight": 600,
        "border_bottom": "1pt solid {color.neutral.300}"
      },
      "body_rows": {
        "alternating_background": ["{color.white}", "{color.neutral.50}"]
      },
      "borders": "minimal"
    },
    "callouts": {
      "tip": {
        "background": "{color.semantic.info}10",
        "border_left": "4pt solid {color.semantic.info}",
        "padding": "12pt"
      },
      "warning": {
        "background": "{color.semantic.warning}10",
        "border_left": "4pt solid {color.semantic.warning}"
      },
      "important": {
        "background": "{color.brand.primary}10",
        "border_left": "4pt solid {color.brand.primary}"
      }
    }
  },
  "usage_rules": {
    "heading_hierarchy": "Never skip heading levels (e.g., H1 → H3)",
    "max_heading_length": "Keep headings under 10 words",
    "paragraph_length": "3-5 sentences per paragraph",
    "bullet_points": "Maximum 6 items per list",
    "tables": "Include header row, keep simple when possible"
  }
}
