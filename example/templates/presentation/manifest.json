{
  "$schema": "https://mrbs.dev/schema/v1/template.manifest.json",
  "template": {
    "type": "presentation",
    "name": "Corporate Presentation",
    "version": "2.0.0",
    "file": "template.pptx",
    "description": "Standard template for corporate presentations",
    "dimensions": {
      "width": 960,
      "height": 540,
      "aspect_ratio": "16:9",
      "unit": "px"
    }
  },
  "layouts": [
    {
      "id": "title",
      "name": "Title Slide",
      "slide_index": 0,
      "purpose": "Opening slide for presentations",
      "usage": "required_first",
      "thumbnail": "thumbnails/title.png",
      "zones": {
        "title": {
          "position": {"x": 60, "y": 180, "width": 840, "height": 120},
          "typography": "title_slide",
          "max_characters": 60,
          "alignment": "center",
          "required": true,
          "placeholder_text": "Presentation Title"
        },
        "subtitle": {
          "position": {"x": 60, "y": 320, "width": 840, "height": 80},
          "typography": "body_large",
          "max_characters": 120,
          "alignment": "center",
          "required": false,
          "placeholder_text": "Subtitle or description"
        },
        "date": {
          "position": {"x": 60, "y": 480, "width": 200, "height": 30},
          "typography": "caption",
          "format": "MMMM D, YYYY",
          "required": false
        },
        "presenter": {
          "position": {"x": 700, "y": 480, "width": 200, "height": 30},
          "typography": "caption",
          "alignment": "right",
          "required": false,
          "placeholder_text": "Presenter Name"
        }
      },
      "background": "brand_gradient",
      "logo_position": "bottom_right",
      "logo_variant": "reversed"
    },
    {
      "id": "section",
      "name": "Section Divider",
      "slide_index": 1,
      "purpose": "Introduce new sections or topics",
      "usage": "recommended_every_5_slides",
      "thumbnail": "thumbnails/section.png",
      "zones": {
        "section_number": {
          "position": {"x": 60, "y": 160, "width": 100, "height": 40},
          "typography": "caption",
          "format": "Section {n}",
          "required": false
        },
        "section_title": {
          "position": {"x": 60, "y": 200, "width": 600, "height": 100},
          "typography": "section_header",
          "max_characters": 40,
          "required": true,
          "placeholder_text": "Section Title"
        },
        "section_description": {
          "position": {"x": 60, "y": 320, "width": 600, "height": 120},
          "typography": "body",
          "max_characters": 200,
          "required": false,
          "placeholder_text": "Brief description of this section"
        }
      },
      "background": "primary_solid",
      "text_color": "white"
    },
    {
      "id": "content_text",
      "name": "Title + Content",
      "slide_index": 2,
      "purpose": "Standard content slide with text",
      "usage": "primary_content",
      "thumbnail": "thumbnails/content-text.png",
      "zones": {
        "slide_title": {
          "position": {"x": 60, "y": 40, "width": 840, "height": 60},
          "typography": "slide_title",
          "max_characters": 50,
          "required": true,
          "placeholder_text": "Slide Title"
        },
        "content": {
          "position": {"x": 60, "y": 120, "width": 840, "height": 380},
          "typography": "body",
          "supports": ["bullets", "numbered_list", "paragraphs"],
          "max_bullets": 6,
          "max_words_per_bullet": 15,
          "required": true,
          "placeholder_text": "• Key point one\n• Key point two\n• Key point three"
        }
      },
      "background": "white"
    },
    {
      "id": "content_two_column",
      "name": "Two Column Content",
      "slide_index": 3,
      "purpose": "Compare or contrast two items",
      "usage": "comparison",
      "thumbnail": "thumbnails/two-column.png",
      "zones": {
        "slide_title": {
          "position": {"x": 60, "y": 40, "width": 840, "height": 60},
          "typography": "slide_title",
          "max_characters": 50,
          "required": true
        },
        "left_heading": {
          "position": {"x": 60, "y": 120, "width": 400, "height": 40},
          "typography": "h4",
          "max_characters": 30
        },
        "left_content": {
          "position": {"x": 60, "y": 170, "width": 400, "height": 330},
          "typography": "body",
          "max_bullets": 5
        },
        "right_heading": {
          "position": {"x": 500, "y": 120, "width": 400, "height": 40},
          "typography": "h4",
          "max_characters": 30
        },
        "right_content": {
          "position": {"x": 500, "y": 170, "width": 400, "height": 330},
          "typography": "body",
          "max_bullets": 5
        }
      }
    },
    {
      "id": "content_image_right",
      "name": "Content + Image",
      "slide_index": 4,
      "purpose": "Content with supporting visual",
      "usage": "visual_support",
      "thumbnail": "thumbnails/content-image.png",
      "zones": {
        "slide_title": {
          "position": {"x": 60, "y": 40, "width": 840, "height": 60},
          "typography": "slide_title",
          "max_characters": 50,
          "required": true
        },
        "content": {
          "position": {"x": 60, "y": 120, "width": 400, "height": 380},
          "typography": "body",
          "max_bullets": 5,
          "max_words_per_bullet": 12,
          "required": true
        },
        "image": {
          "position": {"x": 500, "y": 100, "width": 400, "height": 400},
          "accepts": ["jpg", "png", "svg"],
          "aspect_ratio": "1:1",
          "aspect_ratio_tolerance": 0.3,
          "placeholder": "image_placeholder.png"
        }
      }
    },
    {
      "id": "image_full",
      "name": "Full Image",
      "slide_index": 5,
      "purpose": "Showcase visual with optional caption",
      "usage": "visual_focus",
      "thumbnail": "thumbnails/image-full.png",
      "zones": {
        "slide_title": {
          "position": {"x": 60, "y": 40, "width": 840, "height": 50},
          "typography": "slide_title",
          "max_characters": 50,
          "required": false
        },
        "image": {
          "position": {"x": 60, "y": 100, "width": 840, "height": 380},
          "accepts": ["jpg", "png", "svg"],
          "aspect_ratio": "16:9",
          "aspect_ratio_tolerance": 0.2,
          "required": true
        },
        "caption": {
          "position": {"x": 60, "y": 490, "width": 840, "height": 30},
          "typography": "caption",
          "max_characters": 100,
          "alignment": "center"
        }
      }
    },
    {
      "id": "chart",
      "name": "Data Visualization",
      "slide_index": 6,
      "purpose": "Present data with charts",
      "usage": "data_presentation",
      "thumbnail": "thumbnails/chart.png",
      "zones": {
        "slide_title": {
          "position": {"x": 60, "y": 40, "width": 840, "height": 50},
          "typography": "slide_title",
          "max_characters": 50,
          "required": true
        },
        "chart": {
          "position": {"x": 60, "y": 100, "width": 840, "height": 380},
          "accepts": ["bar", "line", "pie", "area", "scatter", "combo"],
          "max_series": 5,
          "max_categories": 12,
          "colors": "brand_palette",
          "label_typography": "caption",
          "required": true
        },
        "source": {
          "position": {"x": 60, "y": 495, "width": 400, "height": 25},
          "typography": "caption",
          "prefix": "Source: ",
          "required_when": "data_is_external"
        },
        "note": {
          "position": {"x": 500, "y": 495, "width": 400, "height": 25},
          "typography": "caption",
          "alignment": "right"
        }
      }
    },
    {
      "id": "quote",
      "name": "Quote",
      "slide_index": 7,
      "purpose": "Highlight testimonial or key quote",
      "usage": "emphasis",
      "thumbnail": "thumbnails/quote.png",
      "zones": {
        "quote_text": {
          "position": {"x": 100, "y": 160, "width": 760, "height": 200},
          "typography": "h2",
          "max_characters": 200,
          "alignment": "center",
          "style": "italic",
          "required": true,
          "placeholder_text": "\"Quote text goes here\""
        },
        "attribution": {
          "position": {"x": 100, "y": 380, "width": 760, "height": 60},
          "typography": "body",
          "alignment": "center",
          "required": true,
          "placeholder_text": "— Attribution Name, Title"
        }
      },
      "background": "neutral_light"
    },
    {
      "id": "closing",
      "name": "Closing Slide",
      "slide_index": 8,
      "purpose": "End slide with contact or CTA",
      "usage": "required_last",
      "thumbnail": "thumbnails/closing.png",
      "zones": {
        "headline": {
          "position": {"x": 60, "y": 180, "width": 840, "height": 80},
          "typography": "section_header",
          "max_characters": 40,
          "alignment": "center",
          "required": true,
          "placeholder_text": "Thank You"
        },
        "subheadline": {
          "position": {"x": 60, "y": 280, "width": 840, "height": 60},
          "typography": "body_large",
          "max_characters": 80,
          "alignment": "center",
          "placeholder_text": "Questions? Let's discuss."
        },
        "contact": {
          "position": {"x": 60, "y": 400, "width": 840, "height": 80},
          "typography": "body",
          "alignment": "center",
          "max_lines": 3,
          "placeholder_text": "email@example.com\nwww.example.com"
        }
      },
      "background": "brand_gradient",
      "logo_position": "bottom_center",
      "logo_variant": "reversed"
    }
  ],
  "usage_rules": {
    "min_slides": 5,
    "max_slides": 30,
    "max_slides_recommendation": "Keep under 20 for 30-minute presentation",
    "required_layouts": ["title", "closing"],
    "recommended_structure": {
      "first": "title",
      "last": "closing",
      "section_divider_every": 5
    },
    "content_guidelines": {
      "max_bullets_per_slide": 6,
      "max_words_per_bullet": 15,
      "max_words_per_slide": 75,
      "min_font_size": "14pt",
      "one_idea_per_slide": true,
      "data_requires_source": true
    }
  },
  "backgrounds": {
    "white": "#FFFFFF",
    "neutral_light": "#F5F5F5",
    "primary_solid": "{color.brand.primary}",
    "brand_gradient": "linear-gradient(135deg, {color.brand.primary} 0%, {color.brand.primary.dark} 100%)"
  },
  "chart_colors": [
    "{color.brand.primary}",
    "{color.brand.secondary}",
    "{color.neutral.600}",
    "{color.brand.primary.light}",
    "{color.brand.secondary.light}"
  ]
}
