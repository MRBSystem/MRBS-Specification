    "values": [
      "Innovation",
      "Integrity", 
      "Excellence",
      "Collaboration"
    ]
  },
  
  "components": {
    "visual": "./visual/",
    "identity": "./identity/",
    "assets": "./assets/",
    "templates": "./templates/",
    "rules": "./rules/",
    "examples": "./examples/"
  },
  
  "ai_instructions": {
    "priority_order": ["rules", "visual", "templates", "identity"],
    "validation_required": true,
    "fallback_behavior": "conservative"
