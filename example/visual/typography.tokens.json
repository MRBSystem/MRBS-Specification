{
  "$schema": "https://mrbs.dev/schema/v1/typography.tokens.json",
  "typography": {
    "font_family": {
      "heading": {
        "$value": "Inter",
        "$type": "fontFamily",
        "fallback": ["system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
        "weights": [500, 600, 700],
        "usage": "headings, titles, navigation, buttons",
        "source": {
          "type": "google_fonts",
          "url": "https://fonts.google.com/specimen/Inter",
          "license": "OFL-1.1"
        }
      },
      "body": {
        "$value": "Source Sans Pro",
        "$type": "fontFamily",
        "fallback": ["system-ui", "sans-serif"],
        "weights": [400, 600],
        "usage": "body text, descriptions, captions, labels",
        "source": {
          "type": "google_fonts",
          "url": "https://fonts.google.com/specimen/Source+Sans+Pro",
          "license": "OFL-1.1"
        }
      },
      "mono": {
        "$value": "JetBrains Mono",
        "$type": "fontFamily",
        "fallback": ["Consolas", "Monaco", "monospace"],
        "weights": [400, 500],
        "usage": "code, technical content, data tables",
        "source": {
          "type": "google_fonts",
          "url": "https://fonts.google.com/specimen/JetBrains+Mono",
          "license": "OFL-1.1"
        }
      }
    },
    "scale": {
      "base": {
        "$value": "16px",
        "$type": "dimension",
        "description": "Base font size for body text"
      },
      "ratio": {
        "$value": 1.25,
        "$type": "number",
        "description": "Major third scale ratio"
      },
      "h1": {
        "$value": "2.441rem",
        "$type": "dimension",
        "computed": "39.06px",
        "line_height": 1.2,
        "font_weight": 700,
        "font_family": "{typography.font_family.heading}",
        "letter_spacing": "-0.02em",
        "usage": "page_titles, hero_headlines"
      },
      "h2": {
        "$value": "1.953rem",
        "$type": "dimension",
        "computed": "31.25px",
        "line_height": 1.25,
        "font_weight": 600,
        "font_family": "{typography.font_family.heading}",
        "letter_spacing": "-0.01em",
        "usage": "section_titles, modal_titles"
      },
      "h3": {
        "$value": "1.563rem",
        "$type": "dimension",
        "computed": "25px",
        "line_height": 1.3,
        "font_weight": 600,
        "font_family": "{typography.font_family.heading}",
        "usage": "subsection_titles, card_titles"
      },
      "h4": {
        "$value": "1.25rem",
        "$type": "dimension",
        "computed": "20px",
        "line_height": 1.35,
        "font_weight": 500,
        "font_family": "{typography.font_family.heading}",
        "usage": "smaller_headings, labels"
      },
      "body": {
        "$value": "1rem",
        "$type": "dimension",
        "computed": "16px",
        "line_height": 1.6,
        "font_weight": 400,
        "font_family": "{typography.font_family.body}",
        "usage": "paragraphs, descriptions"
      },
      "body_large": {
        "$value": "1.125rem",
        "$type": "dimension",
        "computed": "18px",
        "line_height": 1.6,
        "font_weight": 400,
        "font_family": "{typography.font_family.body}",
        "usage": "lead_paragraphs, introductions"
      },
      "small": {
        "$value": "0.875rem",
        "$type": "dimension",
        "computed": "14px",
        "line_height": 1.5,
        "font_weight": 400,
        "font_family": "{typography.font_family.body}",
        "usage": "supporting_text, meta_information"
      },
      "caption": {
        "$value": "0.75rem",
        "$type": "dimension",
        "computed": "12px",
        "line_height": 1.4,
        "font_weight": 400,
        "font_family": "{typography.font_family.body}",
        "usage": "captions, footnotes, timestamps"
      }
    },
    "presentation": {
      "title_slide": {
        "size": "44pt",
        "weight": 700,
        "line_height": 1.1,
        "max_characters": 60
      },
      "section_header": {
        "size": "36pt",
        "weight": 600,
        "line_height": 1.2,
        "max_characters": 40
      },
      "slide_title": {
        "size": "28pt",
        "weight": 600,
        "line_height": 1.25,
        "max_characters": 50
      },
      "body": {
        "size": "18pt",
        "weight": 400,
        "line_height": 1.5,
        "max_characters_per_line": 75
      },
      "bullet": {
        "size": "18pt",
        "weight": 400,
        "line_height": 1.4,
        "max_words": 15
      },
      "caption": {
        "size": "12pt",
        "weight": 400,
        "line_height": 1.4
      }
    },
    "rules": {
      "max_font_families": 2,
      "heading_font_for_headings_only": true,
      "minimum_body_size": "14px",
      "minimum_line_height": 1.4,
      "maximum_line_length": "75ch"
    }
  }
}
