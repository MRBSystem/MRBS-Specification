{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrbs.dev/schema/v1/brand.manifest.json",
  "title": "MRBS Brand Manifest",
  "description": "Root manifest file for an MRBS-compliant brand system",
  "type": "object",
  "required": [
    "mrbs_version",
    "brand",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "mrbs_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "MRBS specification version"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Brand system version"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date (YYYY-MM-DD)"
    },
    "organization": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Organization name"
        },
        "legal_name": {
          "type": "string",
          "description": "Legal entity name"
        },
        "industry": {
          "type": "string",
          "description": "Industry category"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "headquarters": {
          "type": "string",
          "description": "Headquarters location"
        }
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Primary brand name"
        },
        "tagline": {
          "type": "string",
          "description": "Brand tagline or slogan"
        },
        "mission": {
          "type": "string",
          "description": "Mission statement"
        },
        "vision": {
          "type": "string",
          "description": "Vision statement"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Core brand values"
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "visual": {
          "type": "string",
          "description": "Path to visual tokens directory"
        },
        "identity": {
          "type": "string",
          "description": "Path to identity guidelines directory"
        },
        "assets": {
          "type": "string",
          "description": "Path to brand assets directory"
        },
        "templates": {
          "type": "string",
          "description": "Path to templates directory"
        },
        "rules": {
          "type": "string",
          "description": "Path to rules directory"
        },
        "examples": {
          "type": "string",
          "description": "Path to examples directory"
        }
      },
      "additionalProperties": {
        "type": "string",
        "description": "Custom component paths (use x_ prefix)"
      }
    },
    "ai_instructions": {
      "type": "object",
      "properties": {
        "priority_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Order of precedence when rules conflict"
        },
        "validation_required": {
          "type": "boolean",
          "description": "Whether AI should validate output"
        },
        "fallback_behavior": {
          "type": "string",
          "enum": [
            "conservative",
            "creative"
          ],
          "description": "How to handle ambiguous situations"
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inherits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "description": "Sub-brand or product profiles"
    },
    "provenance": {
      "type": "object",
      "description": "Default provenance for all values in this brand system (1.1.0)",
      "properties": {
        "$status": {
          "type": "string",
          "enum": [
            "official",
            "derived",
            "proposed"
          ],
          "description": "official: approved by the brand owner; derived: computed from official values; proposed: not approved by the owner (1.1.0)"
        },
        "$source": {
          "$ref": "#/$defs/source"
        },
        "$derived_from": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Token references or rule a derived or proposed value comes from (1.1.0)"
        },
        "maintainer": {
          "type": "string"
        }
      }
    },
    "brand_architecture": {
      "type": "object",
      "description": "Links this brand system to a master or member brands (1.1.0)",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "standalone",
            "master",
            "member"
          ],
          "default": "standalone"
        },
        "parent": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "manifest": {
              "type": "string",
              "format": "uri-reference"
            }
          }
        },
        "inherits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assigned": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "manifest": {
                "type": "string",
                "format": "uri-reference"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "role": {
            "const": "member"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "parent"
        ],
        "properties": {
          "parent": {
            "required": [
              "manifest"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "description": "Where a value was taken from (1.1.0)",
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        },
        "page": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    }
  }
}
