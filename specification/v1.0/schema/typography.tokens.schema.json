{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrbs.dev/schema/v1.0/typography.tokens.schema.json",
  "title": "MRBS Typography Tokens Schema",
  "description": "Typography definitions with semantic metadata for AI consumption",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "typography": {
      "type": "object",
      "properties": {
        "font_family": {
          "$ref": "#/$defs/fontFamilyGroup"
        },
        "scale": {
          "$ref": "#/$defs/typeScaleGroup"
        },
        "presentation": {
          "type": "object",
          "description": "Typography settings specific to presentations",
          "additionalProperties": {
            "$ref": "#/$defs/presentationStyle"
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "max_font_families": {
              "type": "number",
              "description": "Maximum number of font families allowed"
            },
            "heading_font_for_headings_only": {
              "type": "boolean"
            },
            "minimum_body_size": {
              "type": "string"
            },
            "minimum_line_height": {
              "type": "number"
            },
            "maximum_line_length": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fontFamilyGroup": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fontFamilyToken"
      }
    },
    "fontFamilyToken": {
      "type": "object",
      "required": ["$value", "$type"],
      "properties": {
        "$value": {
          "type": "string",
          "description": "Font family name or reference"
        },
        "$type": {
          "const": "fontFamily"
        },
        "fallback": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Fallback font stack"
        },
        "weights": {
          "type": "array",
          "items": {"type": "number"},
          "description": "Available font weights"
        },
        "usage": {
          "type": "string",
          "description": "Recommended usage contexts"
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["google_fonts", "adobe_fonts", "custom", "system"]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "license": {
              "type": "string"
            }
          }
        }
      }
    },
    "typeScaleGroup": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/typeScaleToken"
      }
    },
    "typeScaleToken": {
      "type": "object",
      "properties": {
        "$value": {
          "type": ["string", "number"],
          "description": "Font size value or reference"
        },
        "$type": {
          "type": "string",
          "enum": ["dimension", "number"]
        },
        "description": {
          "type": "string"
        },
        "computed": {
          "type": "string",
          "description": "Computed pixel value"
        },
        "line_height": {
          "type": "number"
        },
        "font_weight": {
          "type": "number"
        },
        "font_family": {
          "type": "string",
          "description": "Font family reference"
        },
        "letter_spacing": {
          "type": "string"
        },
        "usage": {
          "type": "string"
        },
        "multiplier": {
          "type": "number",
          "description": "Scale multiplier relative to base"
        }
      }
    },
    "presentationStyle": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "line_height": {
          "type": "number"
        },
        "max_characters": {
          "type": "number"
        },
        "max_characters_per_line": {
          "type": "number"
        },
        "max_words": {
          "type": "number"
        }
      }
    }
  }
}
